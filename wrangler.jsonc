{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "plugtime-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api", "/api/*"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUDIENCE": "", "ALLOWED_EMAIL": "" },
  "d1_databases": [{ "binding": "DB", "database_name": "plugtime-dev", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations", "remote": false }],
  "env": {
    "production": {
      "name": "plugtime",
      "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUDIENCE": "", "ALLOWED_EMAIL": "" },
      "d1_databases": [{ "binding": "DB", "database_name": "plugtime-production", "database_id": "00000000-0000-0000-0000-000000000002", "migrations_dir": "migrations", "remote": false }]
    }
  }
}
